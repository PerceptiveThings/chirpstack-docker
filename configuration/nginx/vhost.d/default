## Start of configuration add by letsencrypt container
location ^~ /.well-known/acme-challenge/ {
    auth_basic off;
    auth_request off;
    allow all;
    root /usr/share/nginx/html;
    try_files $uri =404;
    break;
}
## End of configuration add by letsencrypt container

# Proxy GRPC requests but leave requests like /api.json intact
location ~ ^/api\..*Service/.* {
  grpc_pass grpc://chirpstack:8080;

  # To avoid timeout issues (supposedly only pre-4.0.2 but appears to still be necessary as of 4.10.2):
  # https://forum.chirpstack.io/t/processing-gateway-error-time-out-for-waiting-for-connection/14733/14
  grpc_read_timeout 86400s;
  grpc_send_timeout 86400s;
}
